{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "https://timesheet.rnxadigital.com/", "permanent": false },
    { "source": "/:path*", "destination": "https://timesheet.rnxadigital.com/:path*", "permanent": false }
  ]
}
